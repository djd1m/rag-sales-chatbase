# Суфлёр: основной домен, TLS через общий Caddy на 443.
sufler.site {
    tls {
        issuer acme {
            disable_http_challenge
        }
    }
    encode gzip zstd
    reverse_proxy rag-sales-proxy:80 {
        header_up X-Forwarded-For {remote_host}
    }
}

# Старые ссылки переводим на основной домен с сохранением пути и query string.
rag-sales.78.17.53.233.sslip.io {
    tls {
        issuer acme {
            disable_http_challenge
        }
    }
    redir https://sufler.site{uri} 308
}
