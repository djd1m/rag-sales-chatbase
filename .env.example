# N6 «Суфлёр» — шаблон .env машины. Скопировать в .env, права 600, в git не коммитить.
# Секреты пустые: инфраструктура проверяется Compose, выбранные API-ключи — preflight/VPS check.
# Генерация: openssl rand -hex 24 (пароли), openssl rand -hex 32 (SESSION_SECRET).

# ── правится под машину ──
N6_COMPOSE_PROJECT=n6-sufler
# хостовый порт двери (только петля); проверить: bash ../../scripts/check-port-conflicts.sh projects/06-rag-sales-chatbase
N6_HTTP_PORT=8086
IMAGE_TAG=dev

# ── секреты (пусто = отказ старта) ──
N6_DB_PASSWORD=
REDIS_PASSWORD=
SESSION_SECRET=

# ── оплата ЮKassa (A-N6-040): off — экран интереса; live — нужен СВОЙ магазин N6 (у магазина один адрес уведомлений) ──
# Адрес уведомлений в кабинете ЮKassa: <N6_PUBLIC_ORIGIN>/api/webhooks/yookassa (события payment.succeeded, refund.succeeded)
N6_PAYMENTS_MODE=off
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# true — тестовый магазин, false — боевой; обязан совпадать с магазином (участвует в проверке подлинности платежа)
YOOKASSA_TEST_MODE=
# Ключи только на сервере; заполнить ключи выбранных провайдеров.
# DeepSeek: platform.deepseek.com; Cloud.ru: Foundation Models Key Secret, НЕ S3.
DEEPSEEK_API_KEY=
CLOUDRU_FM_API_KEY=
# Для явного возврата к OpenRouter (для ответов и/или эмбеддингов).
OPENROUTER_API_KEY=

# ── выданный адрес стенда, https:, без завершающего слеша; localhost и пусто — отказ ──
N6_PUBLIC_ORIGIN=

# ── модели (канон §7) ──
ANSWER_PROVIDER=deepseek
ANSWER_MODEL=deepseek-flash
EMBED_PROVIDER=cloudru
EMBED_MODEL=openai/text-embedding-3-small

# ── потолки платных вызовов: 10 scope, 14 переменных (канон §7, A-N6-020) ──
# Изменение — решение владельца, одновременно здесь и в docs/canon.md §7.
QUOTA_VISITOR_ANSWERS=20
QUOTA_IP_ANSWERS=60
QUOTA_BOT_DAY_FREE=50
QUOTA_BOT_DAY_PAID=300
QUOTA_BOT_MONTH_FREE=300
QUOTA_BOT_MONTH_PAID=3000
QUOTA_GLOBAL_ANSWERS=3000
QUOTA_PREVIEW_SESSION_CREATE=1
QUOTA_PREVIEW_SESSION_ANSWERS=10
QUOTA_IP_PREVIEWS=3
QUOTA_GLOBAL_PREVIEWS=200
QUOTA_GLOBAL_PREVIEW_ANSWERS=1000
QUOTA_ACCOUNT_EMBED=2000000
QUOTA_GLOBAL_EMBED=20000000

# customer-trust. Real activation deferred: keep modes off/disabled until configured.
# Keys are read only by the web or the existing mail watchdog; never by browser/proxy/db.
N6_MAIL_MODE=disabled
N6_RESEND_API_KEY=
N6_MAIL_FROM=
N6_SUPPORT_MODE=disabled
N6_SUPPORT_BASE_URL=https://support.clipmkr.ru
N6_SUPPORT_INBOX_ID=
N6_SUPPORT_JWT_SECRET=
N6_SUPPORT_CONTACT_EMAIL=
N6_PRIVACY_CONTACT_EMAIL=
# Receipt values require the merchant's approved full_payment profile. No tax defaults.
N6_YOOKASSA_RECEIPTS_MODE=disabled
N6_YOOKASSA_RECEIPT_VAT_CODE=
N6_YOOKASSA_RECEIPT_PAYMENT_SUBJECT=
N6_YOOKASSA_RECEIPT_PAYMENT_MODE=
N6_YOOKASSA_RECEIPT_TAX_SYSTEM_CODE=
